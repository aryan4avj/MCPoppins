# Jira MCP Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Your Jira instance URL
#   Cloud:       https://your-domain.atlassian.net
#   Data Center: https://jira.your-company.com
JIRA_BASE_URL=

# REQUIRED: Authentication token
#   Cloud:       API token from https://id.atlassian.com/manage-profile/security/api-tokens
#   Data Center: Personal Access Token from your profile settings
JIRA_PAT=

# OPTIONAL: Email (REQUIRED for Jira Cloud basic auth)
# JIRA_EMAIL=

# OPTIONAL: Default project key for my_issues and board queries
# JIRA_PROJECT_KEY=

# OPTIONAL: Restrict to specific projects (comma-separated)
# JIRA_ALLOWED_PROJECTS=PROJ1,PROJ2

# OPTIONAL: Enable writes (default: false = read-only)
JIRA_ENABLE_WRITES=false

# OPTIONAL: Request timeout ms (default: 30000)
# JIRA_REQUEST_TIMEOUT=30000

# OPTIONAL: Max search results 1-100 (default: 25)
# JIRA_MAX_RESULTS=25
